rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Transport One Fleet Management Security Rules
    // Allows authenticated fleet members (both custom email/pass & anonymous session tokens)
    // to read trips, seatbelt records, attendance, and alerts across PC and Mobile devices.

    function signedIn() {
      return request.auth != null;
    }

    match /seatbelt_records/{recordId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /drivers/{driverUid} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /fleet_telemetry/{vehicleCode} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /trips/{tripId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /billing_records/{billingId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /delivery_proofs/{proofId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /fleet_vehicles/{vehicleCode} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /operations_alerts/{alertId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
