# FleetRoute Server Environment Configuration
# STRICTLY ZERO EMOJIS. REAL MONGODB PERSISTENCE ONLY.

PORT=5000
NODE_ENV=development

# Persistent MongoDB Connection URI (Required)
# FleetRoute requires a running MongoDB database instance. In-memory demo fallback is removed.
MONGODB_URI=mongodb://localhost:27017/fleetroute

# JWT Secret Configuration (Required in production)
# Must be set to a cryptographically strong secret (e.g. generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token_in_production
JWT_EXPIRES_IN=24h

# Operational Thresholds
DEFAULT_ARRIVAL_RADIUS_METERS=150
OVERSPEED_THRESHOLD_KMH=80

# Automatic Accident Detection & Zero-Touch Dispatch Configuration
ACCIDENT_DETECTION_ENABLED=true
ACCIDENT_COUNTDOWN_SECONDS=20
ACCIDENT_MIN_CONFIDENCE=0.85
CRASH_G_FORCE_THRESHOLD=4.5
CRASH_SPEED_DROP_THRESHOLD_KMH=25

# Multi-Channel Emergency Escalation Engine
EMERGENCY_ESCALATION_ENABLED=true
EMERGENCY_ESCALATION_INTERVAL_SECONDS=30
EMERGENCY_MAX_RETRY_COUNT=3
EMERGENCY_DATA_RETENTION_DAYS=90

# Emergency Provider Adapters (SMS, Voice, Push, Responders)
SMS_PROVIDER=native_adapter
SMS_PROVIDER_API_KEY=
VOICE_PROVIDER=native_adapter
VOICE_PROVIDER_API_KEY=
PUSH_PROVIDER=native_adapter
AMBULANCE_PARTNER_API_URL=
AMBULANCE_PARTNER_API_KEY=
OFFICIAL_EMERGENCY_INTEGRATION_ENABLED=false
IOT_DEVICE_AUTH_SECRET=
