# Copy these settings into .env.local without overwriting unrelated settings.
# Standard Google Maps key: enable billing and Maps JavaScript API,
# Places API (New), and Routes API. See ../GOOGLE_MAPS_SETUP.md.
VITE_MAP_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_LANGUAGE=en
VITE_GOOGLE_MAPS_REGION=IN

# Optional: explicitly return to the previous Leaflet/OSM provider with
# VITE_MAP_PROVIDER=open. Google data is never rendered on the open map.
