# Browser deployments may omit this when /api is reverse-proxied to the backend.
# Capacitor/Android builds must use a reachable HTTPS backend URL.
VITE_API_BASE_URL=https://api.example.com/api

# Enables direct-open embedded access. The API must separately enable
# PUBLIC_EMBEDDED_ACCESS. No sample operational data is created.
VITE_EMBEDDED_ACCESS=false

# Pure frontend showcase: all modules render with honest empty states and no
# authentication, API, database, mock records, or persistence dependency.
VITE_UI_ONLY_MODE=false
