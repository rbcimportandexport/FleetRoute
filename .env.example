# FleetRoute Environment Configuration Example
# STRICTLY ZERO EMOJIS. REAL MONGODB PERSISTENCE ONLY.
# Copy this file to .env in your root directory or server directory and adjust values as needed.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Comma-separated exact browser origins allowed to call the API.
# Native mobile/server clients without an Origin header remain supported.
CORS_ORIGINS=https://your-fleetroute-web.vercel.app
TRUST_PROXY=true
JSON_BODY_LIMIT=15mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Database Configuration (Mandatory)
# -----------------------------------------------------------------------------
# FleetRoute strictly requires a persistent MongoDB database.
# In-memory document storage fallback is completely removed.
# Startup will cleanly fail if the database connection cannot be established.
MONGODB_URI=mongodb://localhost:27017/fleetroute

# -----------------------------------------------------------------------------
# Authentication & Security (Mandatory)
# -----------------------------------------------------------------------------
# JWT Secret MUST be configured by administrator. No hardcoded fallback exists.
# Generate a strong key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token_in_production
JWT_EXPIRES_IN=24h

# Mandatory before enabling the signed IoT crash-ingestion endpoint.
# Use a distinct random value of at least 32 characters.
IOT_DEVICE_AUTH_SECRET=replace_with_a_distinct_secure_iot_device_secret
IOT_MAX_CLOCK_SKEW_MS=300000

# -----------------------------------------------------------------------------
# Dispatch, Geofencing & Telematics Thresholds
# -----------------------------------------------------------------------------
# Configurable arrival radius in meters for geofence validation during driver check-in
DEFAULT_ARRIVAL_RADIUS_METERS=150

# Overspeed alert threshold in km/h (Evaluated against authentic GPS samples only)
OVERSPEED_THRESHOLD_KMH=80

# GPS polling and transmission interval in milliseconds
LOCATION_UPDATE_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# Map & Geocoding Provider
# -----------------------------------------------------------------------------
# OpenStreetMap Nominatim endpoint for address geocoding search
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search

# External emergency providers are fail-closed until real adapters and receipt
# verification are implemented. Setting a provider label alone does not mark
# messages as delivered.
SMS_PROVIDER=none
VOICE_PROVIDER=none
AMBULANCE_PARTNER_API_PROVIDER=none
HOSPITAL_PARTNER_API_PROVIDER=none
